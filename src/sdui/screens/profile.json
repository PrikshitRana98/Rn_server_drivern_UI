{
    "id": "profile",
    "schemaVersion": 1,
    "title": "SDUI User",
    "showHeader": true,
    "showBack": false,
    "refreshable": true,
    "state": {
        "user": null,
        "loading": false,
        "error": null,
        "email": "",
        "gender": "",
        "formResult": null,
        "formLoading": false,
        "formError": null
    },
    "data": {
        "user": {
            "name": "Rick Sanchez",
            "email": "rick@citadel.com",
            "avatar": "https://rickandmortyapi.com/api/character/avatar/1.jpeg"
        },
        "stats": [
            { "id": "s1", "label": "Adventures", "value": "128" },
            { "id": "s2", "label": "Dimensions", "value": "42" },
            { "id": "s3", "label": "Portals", "value": "9k" }
        ],
        "characters": [
            { "id": "c1", "name": "Rick Sanchez", "status": "Alive", "image": "https://rickandmortyapi.com/api/character/avatar/1.jpeg" },
            { "id": "c2", "name": "Morty Smith", "status": "Alive", "image": "https://rickandmortyapi.com/api/character/avatar/2.jpeg" },
            { "id": "c3", "name": "Summer Smith", "status": "Alive", "image": "https://rickandmortyapi.com/api/character/avatar/3.jpeg" },
            { "id": "c4", "name": "Beth Smith", "status": "Alive", "image": "https://rickandmortyapi.com/api/character/avatar/4.jpeg" },
            { "id": "c5", "name": "Jerry Smith", "status": "Alive", "image": "https://rickandmortyapi.com/api/character/avatar/5.jpeg" },
            { "id": "c6", "name": "Abadango Princess", "status": "Alive", "image": "https://rickandmortyapi.com/api/character/avatar/6.jpeg" },
            { "id": "c7", "name": "Abradolf Lincler", "status": "unknown", "image": "https://rickandmortyapi.com/api/character/avatar/7.jpeg" },
            { "id": "c8", "name": "Adjudicator Rick", "status": "Dead", "image": "https://rickandmortyapi.com/api/character/avatar/8.jpeg" }
        ],
        "menu": [
            { "id": "m1", "title": "Settings", "route": "Settings" },
            { "id": "m2", "title": "Characters", "route": "Home" }
        ]
    },
    "root": {
        "type": "column",
        "style": { "padding": 16, "gap": 16 },
        "children": [
            {
                "type": "card",
                "animation": { "enter": "zoomIn", "duration": 300, "spring": true },
                "style": { "backgroundColor": "$secondary", "padding": 20, "gap": 6 },
                "children": [
                    {
                        "type": "row",
                        "style": { "gap": 8 },
                        "children": [
                            { "type": "text", "props": { "text": "🪔 Diwali EOSS" }, "style": { "flex": 1, "font": "bold", "fontSize": 20, "color": "$white" } },
                            { "type": "text", "animation": { "loop": "float", "loopDuration": 1400 }, "props": { "text": "🎁" }, "style": { "fontSize": 22 } },
                            {
                                "type": "card",
                                "animation": { "loop": "pulse", "loopDuration": 900 },
                                "style": { "backgroundColor": "$warning", "paddingVertical": 4, "paddingHorizontal": 10, "borderRadius": 20 },
                                "children": [
                                    { "type": "text", "props": { "text": "SALE" }, "style": { "font": "bold", "fontSize": 12, "color": "$white" } }
                                ]
                            }
                        ]
                    },
                    { "type": "text", "props": { "text": "Up to 50% OFF on everything" }, "style": { "color": "$white" } },
                    {
                        "type": "text",
                        "animation": { "loop": "blink", "loopDuration": 1600 },
                        "props": { "text": "Ends tonight!" },
                        "style": { "font": "medium", "fontSize": 12, "color": "$white" }
                    }
                ]
            },
            {
                "type": "card",
                "animation": { "enter": "fadeInDown", "delay": 150 },
                "style": { "alignItems": "center", "gap": 8, "padding": 20 },
                "children": [
                    {
                        "type": "image",
                        "props": { "uri": "{{data.user.avatar}}" },
                        "style": { "width": 96, "height": 96, "borderRadius": 48 }
                    },
                    { "type": "text", "props": { "text": "{{data.user.name}}" }, "style": { "font": "bold", "fontSize": 20 } },
                    {
                        "type": "text",
                        "props": { "text": "{{data.user.email}}" },
                        "style": { "color": "$textSecondary" },
                        "action": { "type": "copy", "text": "{{data.user.email}}" }
                    }
                ]
            },
            {
                "type": "list",
                "props": { "items": "{{data.stats}}" },
                "style": { "flexDirection": "row", "gap": 8 },
                "children": [
                    {
                        "type": "card",
                        "animation": { "enter": "fadeInUp", "delay": 300, "stagger": 120, "spring": true },
                        "style": { "flex": 1, "alignItems": "center" },
                        "children": [
                            { "type": "text", "props": { "text": "{{item.value}}" }, "style": { "font": "bold", "fontSize": 18, "color": "$primary" } },
                            { "type": "text", "props": { "text": "{{item.label}}" }, "style": { "fontSize": 12, "color": "$textSecondary" } }
                        ]
                    }
                ]
            },
            {
                "type": "column",
                "style": { "gap": 8 },
                "children": [
                    { "type": "text", "props": { "text": "Characters (FlatList)" }, "style": { "font": "bold", "fontSize": 16 } },
                    {
                        "type": "flatList",
                        "props": { "items": "{{data.characters}}", "numColumns": 2, "emptyText": "No characters" },
                        "style": { "gap": 12, "paddingVertical": 4, "paddingHorizontal": 2 },
                        "children": [
                            {
                                "type": "card",
                                "animation": { "enter": "fadeInUp", "delay": 400, "stagger": 80 },
                                "style": { "flex": 1, "padding": 0, "overflow": "hidden" },
                                "action": { "type": "copy", "text": "{{item.name}}" },
                                "children": [
                                    { "type": "image", "props": { "uri": "{{item.image}}" }, "style": { "height": 150 } },
                                    {
                                        "type": "column",
                                        "style": { "padding": 8, "gap": 2 },
                                        "children": [
                                            { "type": "text", "props": { "text": "{{item.name}}", "numberOfLines": 1 }, "style": { "font": "semiBold", "fontSize": 13 } },
                                            { "type": "text", "props": { "text": "{{item.status}}" }, "style": { "fontSize": 11, "color": "$textSecondary" } }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "card",
                "animation": { "enter": "fadeInDown", "delay": 650 },
                "style": { "gap": 12 },
                "children": [
                    { "type": "text", "props": { "text": "User form" }, "style": { "font": "bold", "fontSize": 16 } },
                    { "type": "text", "props": { "text": "Email" }, "style": { "font": "medium" } },
                    {
                        "type": "input",
                        "props": { "bind": "email", "placeholder": "Enter your email", "keyboardType": "email-address" }
                    },
                    { "type": "text", "props": { "text": "Gender" }, "style": { "font": "medium" } },
                    {
                        "type": "select",
                        "props": {
                            "bind": "gender",
                            "options": [
                                { "label": "Male", "value": "male" },
                                { "label": "Female", "value": "female" },
                                { "label": "Other", "value": "other" }
                            ]
                        }
                    },
                    {
                        "type": "text",
                        "visibleIf": "state.email",
                        "props": { "text": "You typed: {{state.email}} · {{state.gender}}" },
                        "style": { "fontSize": 12, "color": "$textSecondary" }
                    },
                    {
                        "type": "button",
                        "props": { "title": "Submit", "disabled": "{{state.formLoading}}" },
                        "action": {
                            "type": "api",
                            "method": "post",
                            "url": "https://dummyjson.com/users/add",
                            "body": { "email": "{{state.email}}", "gender": "{{state.gender}}" },
                            "validate": { "email": "email", "gender": "required" },
                            "resultKey": "formResult",
                            "loadingKey": "formLoading",
                            "errorKey": "formError"
                        }
                    },
                    { "type": "text", "visibleIf": "state.formLoading", "props": { "text": "Submitting..." }, "style": { "color": "$textSecondary" } },
                    { "type": "text", "visibleIf": "state.formError", "props": { "text": "{{state.formError}}" }, "style": { "color": "$error" } },
                    {
                        "type": "column",
                        "visibleIf": "state.formResult",
                        "style": { "gap": 4 },
                        "children": [
                            { "type": "divider" },
                            { "type": "text", "props": { "text": "✅ User created (POST response)" }, "style": { "font": "bold", "color": "$primary" } },
                            { "type": "text", "props": { "text": "ID: {{state.formResult.id}}" } },
                            { "type": "text", "props": { "text": "Email: {{state.formResult.email}}" } },
                            { "type": "text", "props": { "text": "Gender: {{state.formResult.gender}}" } }
                        ]
                    }
                ]
            },
            {
                "type": "card",
                "animation": { "enter": "fadeInDown", "delay": 750 },
                "style": { "gap": 12 },
                "children": [
                    { "type": "text", "props": { "text": "POST API demo" }, "style": { "font": "bold", "fontSize": 16 } },
                    { "type": "text", "props": { "text": "POST https://dummyjson.com/auth/login" }, "style": { "fontSize": 12, "color": "$textSecondary" } },
                    {
                        "type": "button",
                        "props": { "title": "Get user detail", "disabled": "{{state.loading}}" },
                        "action": {
                            "type": "api",
                            "method": "post",
                            "url": "https://dummyjson.com/auth/login",
                            "body": { "username": "emilys", "password": "emilyspass", "expiresInMins": 30 },
                            "resultKey": "user",
                            "loadingKey": "loading",
                            "errorKey": "error"
                        }
                    },
                    { "type": "text", "visibleIf": "state.loading", "props": { "text": "Loading..." }, "style": { "color": "$textSecondary" } },
                    { "type": "text", "visibleIf": "state.error", "props": { "text": "{{state.error}}" }, "style": { "color": "$error" } },
                    {
                        "type": "column",
                        "visibleIf": "state.user",
                        "style": { "gap": 8 },
                        "children": [
                            {
                                "type": "row",
                                "style": { "gap": 12 },
                                "children": [
                                    { "type": "image", "props": { "uri": "{{state.user.image}}" }, "style": { "width": 56, "height": 56, "borderRadius": 28 } },
                                    {
                                        "type": "column",
                                        "style": { "flex": 1, "gap": 2 },
                                        "children": [
                                            { "type": "text", "props": { "text": "{{state.user.firstName}} {{state.user.lastName}}" }, "style": { "font": "bold", "fontSize": 16 } },
                                            { "type": "text", "props": { "text": "@{{state.user.username}}" }, "style": { "color": "$textSecondary" } }
                                        ]
                                    }
                                ]
                            },
                            { "type": "divider" },
                            { "type": "text", "props": { "text": "ID: {{state.user.id}}" } },
                            { "type": "text", "props": { "text": "Email: {{state.user.email}}" } },
                            { "type": "text", "props": { "text": "Gender: {{state.user.gender}}" } }
                        ]
                    }
                ]
            },
            {
                "type": "card",
                "animation": { "enter": "slideInRight", "delay": 850 },
                "style": { "padding": 0 },
                "children": [
                    {
                        "type": "list",
                        "props": { "items": "{{data.menu}}" },
                        "children": [
                            {
                                "type": "row",
                                "visibleIf": "item.screenId",
                                "style": { "padding": 16, "justifyContent": "space-between" },
                                "action": { "type": "openScreen", "screenId": "{{item.screenId}}" },
                                "children": [
                                    { "type": "text", "props": { "text": "{{item.title}}" }, "style": { "font": "medium" } },
                                    { "type": "text", "props": { "text": "›" }, "style": { "fontSize": 18, "color": "$textSecondary" } }
                                ]
                            },
                            {
                                "type": "row",
                                "visibleIf": "item.route",
                                "style": { "padding": 16, "justifyContent": "space-between" },
                                "action": { "type": "navigate", "screen": "{{item.route}}" },
                                "children": [
                                    { "type": "text", "props": { "text": "{{item.title}}" }, "style": { "font": "medium" } },
                                    { "type": "text", "props": { "text": "›" }, "style": { "fontSize": 18, "color": "$textSecondary" } }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "row",
                "style": { "gap": 12, "marginBottom": 24 },
                "children": [
                    {
                        "type": "button",
                        "animation": { "enter": "fadeInUp", "delay": 950 },
                        "props": { "title": "🛍️ Shop Sale" },
                        "style": {
                            "flex": 1,
                            "width": "auto",
                            "backgroundColor": "$secondary",
                            "borderColor": "$secondary",
                            "borderRadius": 24,
                            "height": 50,
                            "shadowColor": "#CD0105",
                            "shadowOpacity": 0.35,
                            "shadowRadius": 8,
                            "shadowOffset": { "width": 0, "height": 4 },
                            "elevation": 6
                        },
                        "textStyle": { "color": "$white", "font": "bold", "fontSize": 15 },
                        "action": { "type": "navigate", "screen": "Home" }
                    },
                    {
                        "type": "button",
                        "animation": { "enter": "fadeInUp", "delay": 1050 },
                        "props": { "title": "Copy email" },
                        "style": {
                            "flex": 1,
                            "width": "auto",
                            "backgroundColor": "$transparent",
                            "borderColor": "$primary",
                            "borderWidth": 2,
                            "borderRadius": 8,
                            "height": 50
                        },
                        "textStyle": { "color": "$primary", "font": "semiBold", "fontSize": 15 },
                        "action": { "type": "copy", "text": "{{data.user.email}}" }
                    }
                ]
            }
        ]
    }
}
